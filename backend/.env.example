# Copiar este archivo como .env y completar los valores

# Puerto del servidor Express
PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=tp_vehiculos

# Clave secreta para firmar los tokens JWT
JWT_SECRET=cambia_esta_clave_por_una_secreta_larga

# Expiración del token JWT
JWT_EXPIRES_IN=4h
